# IntelliJ IDEA files
.idea/
*.iml
*.iws
*.ipr

# Compiled Java classes (still ignore these)
*.class

# Build directories (keep or remove depending on your setup)
# If your JARs are inside these, DO NOT ignore them
# /target/
# /build/

# Allow JAR files (important if previously ignored)
!*.jar

# Allow artifacts (if stored in a specific folder, e.g. /artifacts/)
!artifacts/
!artifacts/*.jar

# OS files
.DS_Store
Thumbs.db

# Logs
*.log